---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  class?: string;
}

const { eyebrow, title, lead, class: className } = Astro.props;
---

<div class:list={['reveal max-w-[44ch]', className]}>
  <p class="eyebrow flex items-center gap-2.5 text-accent">
    <span class="size-2.5 shrink-0 rounded-full bg-accent"></span>
    {eyebrow}
    <span class="h-px w-14 bg-line"></span>
  </p>
  <h2
    class="mt-4 text-[clamp(1.85rem,4.2vw,2.9rem)] tracking-[-0.025em] text-ink"
  >
    {title}
  </h2>
  {
    lead && (
      <p class="mt-3.5 max-w-[60ch] text-[1.03rem] text-ink-muted">{lead}</p>
    )
  }
</div>
