---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  class?: string;
}

const { eyebrow, title, lead, class: className } = Astro.props;
---

{/* Widths mirror the approved design: 640px for the title, 660px for the
    lead. They are set per element rather than on the wrapper, so the eyebrow
    rule still runs its full length. */}
<div class:list={['reveal', className]}>
  <p class="eyebrow flex items-center gap-2.5 text-accent">
    <span class="size-2.5 shrink-0 rounded-full bg-accent"></span>
    {eyebrow}
    <span class="h-px w-14 bg-line"></span>
  </p>
  <h2
    class="mt-4 max-w-160 text-[clamp(1.75rem,3.6vw,2.375rem)] tracking-[-0.03em] text-ink"
  >
    {title}
  </h2>
  {
    lead && (
      <p class="mt-3.5 max-w-165 text-[1.03rem] text-ink-muted">{lead}</p>
    )
  }
</div>
