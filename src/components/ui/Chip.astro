---
interface Props {
  /** Accent styling, used for AI-focused technologies. */
  highlight?: boolean;
}

const { highlight = false } = Astro.props;
---

<span
  class:list={[
    'rounded-token border px-2 py-0.5 font-mono text-[0.65rem] whitespace-nowrap',
    highlight
      ? 'border-accent-wash bg-accent-wash text-accent'
      : 'border-line-soft bg-surface-muted text-ink-muted',
  ]}
>
  <slot />
</span>
