---
import { Icon } from 'astro-icon/components';
import { getTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = getTranslations(lang);
---

<button
  type="button"
  data-theme-toggle
  aria-label={t('a11y.theme')}
  title={t('a11y.theme')}
  class:list={[
    'grid size-9 shrink-0 place-items-center rounded-control border border-line bg-surface text-ink-muted transition-colors hover:border-accent hover:text-accent',
    className,
  ]}
>
  {/* Both icons ship and CSS picks one, so the control is already correct on
      first paint without waiting for JavaScript. */}
  <Icon name="lucide:sun" class="size-4 icon-to-light" />
  <Icon name="lucide:moon" class="size-4 icon-to-dark" />
</button>

<style>
  /* Dark is the default, so the button offers the switch to light. */
  .icon-to-light {
    display: block;
  }
  .icon-to-dark {
    display: none;
  }

  :root[data-theme='light'] .icon-to-light {
    display: none;
  }
  :root[data-theme='light'] .icon-to-dark {
    display: block;
  }
</style>

<script>
  import { initThemeToggle } from '../../scripts/theme';

  initThemeToggle();
</script>
