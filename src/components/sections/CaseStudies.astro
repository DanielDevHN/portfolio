---
import { Icon } from 'astro-icon/components';
import { getTranslations, type Lang } from '../../i18n/utils';
import { getCaseStudies } from '../../lib/content';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const cases = await getCaseStudies(lang);
---

<section id="cases" class="scroll-mt-24 py-20 lg:py-28">
  <div class="rail">
    <SectionHeader
      eyebrow={t('cases.eyebrow')}
      title={t('cases.title')}
      lead={t('cases.lead')}
      class="mb-12"
    />

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        cases.map(({ id, icon, organization, title, description, tech }) => (
          <li
            class="reveal flex flex-col overflow-hidden rounded-(--radius-card) border border-line bg-surface transition-all duration-300 hover:-translate-y-1 hover:border-ink-faint hover:shadow-(--shadow-raised)"
            data-case={id}
          >
            <div class="case-band flex items-center border-b border-line-soft px-6 py-6">
              <span class="grid size-11.5 place-items-center rounded-xl border border-line bg-surface text-accent">
                <Icon name={`lucide:${icon}`} class="size-5.5" />
              </span>
            </div>

            <div class="flex flex-1 flex-col gap-2.5 p-6">
              <p class="font-mono text-[0.64rem] tracking-widest text-ink-faint uppercase">
                {organization}
              </p>
              <h3 class="text-[1.02rem] leading-tight tracking-tight text-ink">
                {title}
              </h3>
              <p class="flex-1 text-[0.88rem] text-ink-muted">{description}</p>
              <p class="mt-2 border-t border-dashed border-line pt-3 font-mono text-[0.7rem] text-flow">
                {tech}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .case-band {
    background-image:
      radial-gradient(80% 100% at 20% 0%, var(--accent-wash), transparent 62%),
      radial-gradient(70% 100% at 100% 100%, var(--flow-wash), transparent 60%);
    background-color: var(--surface-muted);
  }
</style>
