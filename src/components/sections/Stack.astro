---
import { stackGroups } from '../../data/stack';
import { getTranslations, type Lang } from '../../i18n/utils';
import Chip from '../ui/Chip.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="stack" class="scroll-mt-24 bg-canvas-deep py-20 lg:py-28">
  <div class="rail">
    <SectionHeader
      eyebrow={t('stack.eyebrow')}
      title={t('stack.title')}
      lead={t('stack.lead')}
      class="mb-12"
    />

    <div
      class="reveal grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        stackGroups.map(({ id, titleKey, highlight, items }) => (
          <section class="bg-canvas p-6" data-stack-group={id}>
            <h3 class="flex items-center gap-2.5 text-[0.95rem] tracking-tight text-ink">
              <span
                class:list={[
                  'size-1.5 shrink-0 rounded-full',
                  highlight ? 'bg-accent' : 'bg-flow',
                ]}
              />
              {t(titleKey)}
            </h3>
            <ul class="mt-3.5 flex flex-wrap gap-1.5">
              {items.map((item) => (
                <li>
                  <Chip highlight={highlight}>{item}</Chip>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>
