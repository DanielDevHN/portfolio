---
import { Icon } from 'astro-icon/components';
import { getTranslations, type Lang } from '../../i18n/utils';
import WorkflowDiagram from './WorkflowDiagram.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const stats = [
  { value: t('hero.stat.1.value'), label: t('hero.stat.1.label') },
  { value: t('hero.stat.2.value'), label: t('hero.stat.2.label') },
  { value: t('hero.stat.3.value'), label: t('hero.stat.3.label') },
  { value: t('hero.stat.4.value'), label: t('hero.stat.4.label') },
];
---

<section class="relative overflow-hidden pt-14 pb-20 lg:pt-20">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="grid-backdrop absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="rail grid items-center gap-10 lg:grid-cols-[1.02fr_0.98fr]">
    <div class="reveal">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-line bg-surface py-1.5 pr-3.5 pl-2.5 shadow-card"
      >
        <span class="size-[7px] shrink-0 rounded-full bg-flow"></span>
        <span class="eyebrow text-ink-muted">{t('hero.status')}</span>
      </p>

      <h1
        class="mt-5 text-[clamp(2.4rem,6.1vw,4.4rem)] tracking-[-0.035em] text-ink"
      >
        {t('hero.headline.1')}<br />
        {t('hero.headline.2')}<br />
        <span class="text-accent">{t('hero.headline.3')}</span>
      </h1>

      <p class="mt-6 max-w-[56ch] text-[1.06rem] text-ink-muted">
        {t('hero.lead')}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#services"
          class="inline-flex items-center gap-2 rounded-control bg-accent px-5 py-3 font-semibold text-on-accent transition-colors hover:bg-accent-strong"
        >
          {t('hero.cta.primary')}
          <Icon name="lucide:arrow-right" class="size-4" />
        </a>
        <a
          href="#experience"
          class="inline-flex items-center rounded-control border border-line bg-surface px-5 py-3 font-semibold text-ink transition-colors hover:border-ink-faint"
        >
          {t('hero.cta.secondary')}
        </a>
      </div>

      <dl
        class="mt-10 grid gap-px overflow-hidden rounded-control border border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          stats.map(({ value, label }) => (
            <div class="bg-canvas px-4 py-3.5">
              <dt class="sr-only">{label}</dt>
              <dd class="font-display text-[1.28rem] font-bold tracking-tight tabular-nums">
                {value}
              </dd>
              <p class="mt-0.5 font-mono text-[0.63rem] tracking-widest text-ink-faint uppercase">
                {label}
              </p>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="reveal">
      <WorkflowDiagram lang={lang} />
    </div>
  </div>
</section>

<style>
  .hero-glow {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 130%;
    z-index: -20;
    background:
      radial-gradient(
        58% 46% at 78% 8%,
        color-mix(in srgb, var(--accent) 16%, transparent),
        transparent 68%
      ),
      radial-gradient(
        46% 40% at 12% 78%,
        color-mix(in srgb, var(--flow) 14%, transparent),
        transparent 70%
      );
  }
</style>
