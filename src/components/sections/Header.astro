---
import { Icon } from 'astro-icon/components';
import { AUTHOR } from '../../config/site';
import { getTranslations, type Lang, localizedPath } from '../../i18n/utils';
import LangSwitch from '../ui/LangSwitch.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const navItems = [
  { href: '#services', label: t('nav.services') },
  { href: '#stack', label: t('nav.stack') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#cases', label: t('nav.cases') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header
  class="sticky top-0 z-50 border-b border-line-soft bg-canvas/80 backdrop-blur-md backdrop-saturate-150"
>
  <div class="rail flex h-[4.125rem] items-center gap-4">
    <a
      href={localizedPath(lang)}
      class="flex items-center gap-2.5 font-display text-[1.02rem] font-bold tracking-tight"
    >
      <span
        class="grid size-[30px] place-items-center rounded-lg bg-accent font-mono text-[0.72rem] font-bold text-on-accent"
        aria-hidden="true">{AUTHOR.initials}</span
      >
      {AUTHOR.name}
    </a>

    <nav
      aria-label={t('a11y.primaryNav')}
      class="ml-auto hidden items-center gap-6 lg:flex"
    >
      {
        navItems.map(({ href, label }) => (
          <a
            href={href}
            class="text-sm text-ink-muted transition-colors hover:text-ink"
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2.5 lg:ml-6">
      <LangSwitch lang={lang} />
      <ThemeToggle lang={lang} />
      <a
        href="#contact"
        class="hidden rounded-control bg-accent px-4 py-2.5 text-sm font-semibold text-on-accent transition-colors hover:bg-accent-strong sm:block"
      >
        {t('nav.cta')}
      </a>

      {/* Native disclosure: a mobile menu that needs no JavaScript. */}
      <details class="relative lg:hidden">
        <summary
          class="grid size-9 cursor-pointer list-none place-items-center rounded-control border border-line bg-surface text-ink [&::-webkit-details-marker]:hidden"
          aria-label={t('a11y.openMenu')}
        >
          <Icon name="lucide:menu" class="size-4" />
        </summary>
        <nav
          aria-label={t('a11y.primaryNav')}
          class="absolute right-0 mt-2.5 flex w-52 flex-col gap-1 rounded-card border border-line bg-surface p-2 shadow-raised"
        >
          {
            navItems.map(({ href, label }) => (
              <a
                href={href}
                class="rounded-token px-3 py-2 text-sm text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink"
              >
                {label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
